# Server Runtime
PORT=3000
NODE_ENV=development

# APP_URL: The URL where this applet is hosted (set automatically in Cloud Run / AI Studio)
APP_URL=

# Master Encryption Key for sensitive database fields (SMTP passwords, MFA secrets, Device API keys)
# Provide a 32+ character secret in production. If omitted locally, server generates data/.master.key (0600).
APP_ENCRYPTION_KEY=

# Google Identity Services OAuth Client ID (optional; required only for verified Google Sign-In tokens)
GOOGLE_CLIENT_ID=

# Default Corporate SMTP Fallback (can also be configured per-tenant in System Admin -> SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional Telegram Bot Notification Channel
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# GEMINI_API_KEY: Optional Gemini API key if using AI features server-side
GEMINI_API_KEY=
