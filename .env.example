# ==============================================================================
# Seven Sunday Ethiopia Manufacturing & Trading PLC - Environment Configuration
# Copy this file to `.env` for local runs, or set these variables in Render /
# Cloud Run environment settings. NEVER commit real secrets to version control.
# ==============================================================================

# --- 1. Server Runtime --------------------------------------------------------
# Port the Express + WebSocket + Vite server listens on (3000 by default)
PORT=3000
# Set to "production" on Render / live servers
NODE_ENV=development
# Public base URL of the deployed service (auto-set in Cloud Run / Render)
APP_URL=https://ais-dev-q32nxysxb7xbuiylbxztos-336962189.us-west2.run.app

# --- 2. Persistent Storage (SQLite + Backups) ---------------------------------
# Directory for sevensunday.db, automated backups, and .master.key.
# On Render with a Persistent Disk mounted at /var/data, set: DATA_DIR=/var/data
DATA_DIR=./data

# --- 3. Encryption & Security -------------------------------------------------
# 32+ character high-entropy key for AES-256-GCM encryption of SMTP passwords,
# MFA secrets, and device API keys (generate with: openssl rand -hex 32).
# If omitted locally, server generates data/.master.key automatically.
APP_ENCRYPTION_KEY=

# --- 4. Firebase & Render Authorized Domain Whitelist -------------------------
# Exact Render hostname (without https://) added to Firebase domain whitelist
VITE_RENDER_DOMAIN=sevensundayethiopia.onrender.com
# Custom domain (without https://) if using a corporate domain such as portal.sevensundayethiopia.com
VITE_APP_DOMAIN=
# Optional override for Firebase authDomain (defaults to firebase-applet-config.json authDomain)
VITE_FIREBASE_AUTH_DOMAIN=
# Set to "true" only if Render reverse-proxies /__/auth/* to Firebase Hosting
VITE_FIREBASE_USE_CUSTOM_AUTH_DOMAIN=false

# --- 5. Google Identity Services OAuth (Optional) -----------------------------
# Server-side Google OAuth Client ID (falls back to firebase-applet-config.json oAuthClientId)
GOOGLE_CLIENT_ID=

# --- 6. Corporate SMTP Email Fallback -----------------------------------------
# Can also be configured per-tenant inside Company Administration -> SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@sevensundayethiopia.com

# --- 7. Telegram Bot Notifications (Optional) ---------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- 8. Optional Server AI / Dev Flags ----------------------------------------
GEMINI_API_KEY=
DISABLE_HMR=true
